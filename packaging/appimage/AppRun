#!/usr/bin/env bash
# AppRun of the ALBW native port AppImage. The game is a 32-bit program: the bundled libraries cover
# SDL3 and zlib; 32-bit glibc and the 32-bit OpenGL driver must come from the system.
#
#   ./ALBW-native-x86_64.AppImage [--rom /path/to/game.3ds] [game options]
#   ALBW_ROM=/path/to/game.3ds ./ALBW-native-x86_64.AppImage
# The ROM path is remembered in ~/.config/albw-port/rom_path (the same file build.sh writes).
HERE="$(dirname "$(readlink -f "$0")")"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/albw-port"

msg() {   # terminal, else a desktop dialog
    if [[ -t 2 ]]; then printf '%s\n' "$*" >&2
    elif command -v zenity >/dev/null; then zenity --error --no-wrap --text="$*" 2>/dev/null
    elif command -v kdialog >/dev/null; then kdialog --error "$*" 2>/dev/null
    else printf '%s\n' "$*" >&2; fi
}

ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --rom) ALBW_ROM="$2"; shift 2 ;;
        --rom=*) ALBW_ROM="${1#--rom=}"; shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
: "${ALBW_ROM:=$(cat "$CFG/rom_path" 2>/dev/null)}"
if [[ ! -f "${ALBW_ROM:-}" ]]; then
    pick=""
    if [[ ! -t 0 ]] && command -v zenity >/dev/null; then
        pick=$(zenity --file-selection --title="Choose your decrypted A Link Between Worlds .3ds (EU)" 2>/dev/null)
    elif [[ ! -t 0 ]] && command -v kdialog >/dev/null; then
        pick=$(kdialog --getopenfilename "$HOME" "*.3ds *.cci" --title "Choose your decrypted .3ds" 2>/dev/null)
    fi
    [[ -n $pick ]] && ALBW_ROM=$pick
fi
if [[ ! -f "${ALBW_ROM:-}" ]]; then
    msg "No game file. Run with --rom /path/to/your/decrypted.3ds (EU release), or set ALBW_ROM."
    exit 1
fi
mkdir -p "$CFG" && printf '%s\n' "$(readlink -f "$ALBW_ROM")" > "$CFG/rom_path"
export ALBW_ROM

# Steam can start the game inside its own container (pressure-vessel: a non-Steam game with a "Steam Linux
# Runtime" compatibility setting). There the system's libraries and graphics driver sit under
# /usr/lib/pressure-vessel/overrides, and the library path Steam set up has to be kept.
PV=0
[[ ${container:-} == pressure-vessel || -d /run/pressure-vessel ]] && PV=1

# 32-bit system pieces the AppImage cannot carry (they must match the system: libc, GPU driver)
lib32_has() {
    local d dirs=(/usr/lib32 /usr/lib/i386-linux-gnu /lib/i386-linux-gnu)
    local o=/usr/lib/pressure-vessel/overrides/lib/i386-linux-gnu
    [[ $PV == 1 ]] && dirs+=("$o" "$o/aliases")
    [[ -d /usr/lib64 && ! -d /usr/lib32 ]] && dirs+=(/usr/lib)   # Fedora/openSUSE layout
    for d in "${dirs[@]}"; do compgen -G "$d/$1" >/dev/null && return 0; done
    return 1
}
need=0
[[ -e /lib/ld-linux.so.2 ]] || need=1
lib32_has "libGL.so.1" || lib32_has "libEGL.so.1" || need=1
if [[ $need == 1 ]]; then
    msg "This game needs the 32-bit C library and 32-bit OpenGL from your system:
  Ubuntu/Debian/Mint: sudo dpkg --add-architecture i386; sudo apt update
                      sudo apt install libc6:i386 libgl1:i386 libegl1:i386 libgl1-mesa-dri:i386
  Fedora:   sudo dnf install glibc.i686 mesa-libGL.i686 mesa-libEGL.i686 mesa-dri-drivers.i686
  Arch:     enable [multilib], then: sudo pacman -S lib32-glibc lib32-mesa
  openSUSE: sudo zypper install glibc-32bit Mesa-libGL1-32bit Mesa-libEGL1-32bit Mesa-dri-32bit
  NVIDIA:   also the 32-bit NVIDIA GL libraries (lib32-nvidia-utils, libnvidia-gl-*:i386, ...)"
    exit 1
fi

# native Wayland only when its 32-bit pieces exist (same choice as run.sh); X11/XWayland otherwise
WAYLAND_GL_OK=1
if [[ -e /proc/driver/nvidia/version ]] && ! lib32_has "libnvidia-egl-wayland.so*"; then WAYLAND_GL_OK=0; fi
# Steam Deck Game Mode (gamescope session): games run on gamescope's XWayland (DISPLAY). Native Wayland
# there needs 32-bit pieces SteamOS does not have, so use X11 (GitHub issue 8).
GAMESCOPE=0
if [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" || "${XDG_CURRENT_DESKTOP:-}" == *gamescope* || ( -n "${SteamDeck:-}" && -n "${SteamGamepadUI:-}" ) ]]; then
    GAMESCOPE=1
fi
# Steam preloads its overlay (gameoverlayrenderer.so) into every non-Steam shortcut; it hooks GL/SDL inside
# the game and AppImages are known to fail to start with it in Game Mode. The game has its own menu
# (L3+R3), so run without it.
if [[ $GAMESCOPE == 1 ]]; then unset LD_PRELOAD; fi
if [[ $GAMESCOPE == 1 && -n "${DISPLAY:-}" && -z "${SDL_VIDEO_DRIVER:-}" ]]; then
    export SDL_VIDEO_DRIVER=x11
elif [[ -n "${WAYLAND_DISPLAY:-}" && -z "${SDL_VIDEO_DRIVER:-}" && $WAYLAND_GL_OK == 1 ]] && lib32_has "libxkbcommon.so.0"; then
    export SDL_VIDEO_DRIVER=wayland
fi

# fallback libraries: only those the system has no 32-bit copy of (linked into a private folder)
LIBS="$HERE/usr/lib"
if [[ -d "$HERE/usr/lib/fallback" ]]; then
    FBDIR="${XDG_RUNTIME_DIR:-/tmp}/albw-port-fallback-$UID"
    rm -rf "$FBDIR" && mkdir -p "$FBDIR"
    for f in "$HERE"/usr/lib/fallback/*; do
        lib32_has "$(basename "$f")" || ln -s "$f" "$FBDIR/"
    done
    [[ -n "$(ls -A "$FBDIR")" ]] && LIBS="$LIBS:$FBDIR"
fi
# SteamOS has no 32-bit X11 libraries of its own: Steam's runtime provides them through the very
# LD_LIBRARY_PATH dropped below, and without them SDL says "x11 not available" (issue 8). Borrow just those
# 32-bit X11 libraries (not Steam's libGL / libstdc++), only for the ones the system lacks.
BORROWED=""
if [[ $PV == 0 && ( $GAMESCOPE == 1 || -n "${STEAM_RUNTIME:-}" ) && -n "${LD_LIBRARY_PATH:-}" ]]; then
    mkdir -p "${FBDIR:=${XDG_RUNTIME_DIR:-/tmp}/albw-port-fallback-$UID}"
    IFS=: read -ra SDIRS <<< "$LD_LIBRARY_PATH"
    for d in "${SDIRS[@]}"; do
        [[ -d "$d" ]] || continue
        for f in "$d"/libX11.so.6* "$d"/libX11-xcb.so.1* "$d"/libXext.so.6* "$d"/libXcursor.so.1* "$d"/libXi.so.6* \
                 "$d"/libXfixes.so.3* "$d"/libXrandr.so.2* "$d"/libXrender.so.1* "$d"/libXss.so.1* "$d"/libxcb.so.1* \
                 "$d"/libXau.so.6* "$d"/libXdmcp.so.6* "$d"/libxkbcommon.so.0*; do
            [[ -e "$f" ]] || continue
            b=$(basename "$f")
            [[ -e "$FBDIR/$b" ]] && continue
            lib32_has "$b" && continue
            [[ "$(od -An -tx1 -j4 -N1 "$f" 2>/dev/null | tr -d ' ')" == 01 ]] || continue   # 32-bit ELF only
            ln -s "$f" "$FBDIR/$b" && BORROWED="$BORROWED $b"
        done
    done
    case ":$LIBS:" in *":$FBDIR:"*) ;; *) [[ -n "$(ls -A "$FBDIR")" ]] && LIBS="$LIBS:$FBDIR" ;; esac
fi
# Steam's run.sh points LD_LIBRARY_PATH at its own runtime libraries (older Ubuntu libstdc++, libGL, ...);
# the game would load those instead of the system's 32-bit Mesa. Only our own folders, as the Krita
# AppImage does for the same reason (ValveSoftware/steam-runtime#189).
if [[ $PV == 0 && ( $GAMESCOPE == 1 || -n "${STEAM_RUNTIME:-}" ) ]]; then
    export LD_LIBRARY_PATH="$LIBS"
else
    export LD_LIBRARY_PATH="$LIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
# version (packaging/VERSION is copied next to AppRun by make_appimage.sh)
[[ -f "$HERE/VERSION" ]] && export ALBW_VERSION="$(cat "$HERE/VERSION")"
# no terminal (Steam Game Mode, desktop launchers): keep the output in a log file, there is nowhere else to read it.
# The game's Help menu (Esc) copies it to the clipboard (ALBW_LOG_FILE). If the game stops with an error before
# a window exists, show the end of the log and put it on the clipboard where a tool for that exists.
if [[ ! -t 2 ]]; then
    LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/albw-port"
    if mkdir -p "$LOGDIR" 2>/dev/null; then
        export ALBW_LOG_FILE="$LOGDIR/last-run.log"
        { echo "== ALBW native ${ALBW_VERSION:-(unknown version)} $(date) game mode=$GAMESCOPE steam container=$PV LD_LIBRARY_PATH=$LD_LIBRARY_PATH SDL_VIDEO_DRIVER=${SDL_VIDEO_DRIVER:-} DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} borrowed:${BORROWED:- none}"
          echo "   x11 sockets: $(ls /tmp/.X11-unix 2>&1 | tr '\n' ' ') XAUTHORITY=${XAUTHORITY:-} GAMESCOPE_WAYLAND_DISPLAY=${GAMESCOPE_WAYLAND_DISPLAY:-} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
          echo "   system 32-bit libX11: $(lib32_has libX11.so.6 && echo yes || echo no)  fallback dir: $(ls "${FBDIR:-/nonexistent}" 2>/dev/null | tr '\n' ' ')"; } > "$ALBW_LOG_FILE"
        "$HERE/usr/bin/albw" "${ARGS[@]+"${ARGS[@]}"}" >> "$ALBW_LOG_FILE" 2>&1
        rc=$?
        if [[ $rc != 0 && $GAMESCOPE == 0 ]]; then
            tail -c 60000 "$ALBW_LOG_FILE" > "$LOGDIR/report.txt"
            if   command -v wl-copy >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then wl-copy < "$LOGDIR/report.txt"
            elif command -v xclip   >/dev/null && [[ -n ${DISPLAY:-} ]]; then xclip -selection clipboard < "$LOGDIR/report.txt"
            elif command -v xsel    >/dev/null && [[ -n ${DISPLAY:-} ]]; then xsel -ib < "$LOGDIR/report.txt"; fi
            msg "The game stopped (code $rc). The end of the log:

$(tail -n 12 "$ALBW_LOG_FILE" | cut -c1-200)

Full log: $ALBW_LOG_FILE
When reporting a problem, attach that file (or paste it from the clipboard if your system could copy it)."
        fi
        exit $rc
    fi
fi
exec "$HERE/usr/bin/albw" "${ARGS[@]+"${ARGS[@]}"}"
